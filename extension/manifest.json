{
  "manifest_version": 3,
  "name": "Pathfinder — browser feedback",
  "version": "0.2.0",
  "description": "Передаёт локальному Pathfinder результаты загрузки страниц без URL-путей и содержимого.",
  "permissions": ["storage", "webRequest", "alarms"],
  "host_permissions": ["https://*/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "options_page": "options.html",
  "action": {"default_title": "Подключить Pathfinder"}
}
